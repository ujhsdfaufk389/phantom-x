<!--
  PHANTOM-X :: Sysmon configuration for fileless / PDF-chain research
  ============================================================================
  Validate BEFORE deploying (Linux or Windows, no Sysmon required):

      python3 validate_sysmon_config.py sysmon_config.xml

  Install / apply (elevated PowerShell on the research VM):

      .\Sysmon64.exe -accepteula -i sysmon_config.xml     # first time
      .\Sysmon64.exe -c sysmon_config.xml                 # apply changes

  Confirm on the VM:

      .\Sysmon64.exe -c             # dump the effective configuration
      .\Sysmon64.exe -s 4.90        # print the schema this build accepts
      Get-WinEvent -LogName 'Microsoft-Windows-Sysmon/Operational' -MaxEvents 5

  Design notes
    * EXACTLY ONE rule block per event type. Sysmon merges rule blocks that
      share an event name; an include block and an exclude block for the same
      event therefore interact unpredictably and can produce a rule that
      silently never matches. The validator rejects this pattern.
    * schemaversion is 4.90. Newer Sysmon builds accept older schemas, so
      4.90 gives the widest deployment range while still supporting
      ProcessTampering (event 25), which is a high-value signal for process
      hollowing.
    * This config records OBSERVABLE BEHAVIOUR. It enables, disables and
      influences nothing. It does not modify Defender or any other control.
-->
<Sysmon schemaversion="4.90">

  <EventFiltering>

    <!-- ===================================================================
         Event 1 - Process creation
         The primary signal for "a PDF reader spawned something".
         Exclude-based so that EVERY child process is captured, including
         ones no rule author anticipated. Parent/child linkage comes free
         via ParentImage / ParentProcessId / ParentCommandLine.
         =================================================================== -->
    <ProcessCreate onmatch="exclude">
      <!-- Exclude Sysmon's own components to avoid feedback loops. -->
      <Image condition="contains">\Sysmon64.exe</Image>
      <Image condition="contains">\Sysmon64a.exe</Image>
      <Image condition="contains">\Sysmon.exe</Image>
    </ProcessCreate>

    <!-- ===================================================================
         Event 3 - Network connection
         "Network communication" stage of the chain. Exclude-based to catch
         any port, not just the ones anticipated here. Loopback is excluded
         to keep the volume usable.
         =================================================================== -->
    <NetworkConnect onmatch="exclude">
      <SourceIp condition="is">127.0.0.1</SourceIp>
    </NetworkConnect>

    <!-- ===================================================================
         Event 22 - DNS query
         Catches name resolution that does not surface as a TCP connection.
         =================================================================== -->
    <DnsQuery onmatch="exclude">
      <QueryName condition="end with">.local</QueryName>
    </DnsQuery>

    <!-- ===================================================================
         Event 7 - Image load
         Module loads INTO a process. Scoped to PDF readers and script hosts
         so that a DLL sideload or a reflective-load staging step is visible
         without drowning the log in every system DLL load on the host.
         =================================================================== -->
    <ImageLoad onmatch="include">
      <Image condition="contains">\AcroRd32.exe</Image>
      <Image condition="contains">\AcroEdge.exe</Image>
      <Image condition="contains">\Acrobat.exe</Image>
      <Image condition="contains">\FoxitReader.exe</Image>
      <Image condition="contains">\SumatraPDF.exe</Image>
      <Image condition="contains">\msedge.exe</Image>
      <Image condition="contains">\chrome.exe</Image>
      <Image condition="contains">\powershell.exe</Image>
      <Image condition="contains">\pwsh.exe</Image>
      <Image condition="contains">\wscript.exe</Image>
      <Image condition="contains">\cscript.exe</Image>
    </ImageLoad>

    <!-- ===================================================================
         Event 11 - File create
         Catches the classic drop locations and the file types that matter.
         =================================================================== -->
    <FileCreate onmatch="include">
      <TargetFilename condition="contains">\AppData\Local\Temp\</TargetFilename>
      <TargetFilename condition="contains">\AppData\Roaming\</TargetFilename>
      <TargetFilename condition="contains">\Windows\Temp\</TargetFilename>
      <TargetFilename condition="contains">\Users\Public\</TargetFilename>
      <TargetFilename condition="contains">\Downloads\</TargetFilename>
      <TargetFilename condition="contains">\Start Menu\Programs\Startup\</TargetFilename>
      <TargetFilename condition="end with">.exe</TargetFilename>
      <TargetFilename condition="end with">.dll</TargetFilename>
      <TargetFilename condition="end with">.ps1</TargetFilename>
      <TargetFilename condition="end with">.vbs</TargetFilename>
      <TargetFilename condition="end with">.js</TargetFilename>
      <TargetFilename condition="end with">.jse</TargetFilename>
      <TargetFilename condition="end with">.hta</TargetFilename>
      <TargetFilename condition="end with">.bat</TargetFilename>
      <TargetFilename condition="end with">.cmd</TargetFilename>
      <TargetFilename condition="end with">.lnk</TargetFilename>
      <TargetFilename condition="end with">.pdf</TargetFilename>
      <TargetFilename condition="end with">.tmp</TargetFilename>
      <TargetFilename condition="end with">.dat</TargetFilename>
      <TargetFilename condition="end with">.iso</TargetFilename>
    </FileCreate>

    <!-- ===================================================================
         Event 12/13/14 - Registry
         Persistence indicators and security-control tampering.
         =================================================================== -->
    <RegistryEvent onmatch="include">
      <TargetObject condition="contains">\CurrentVersion\Run</TargetObject>
      <TargetObject condition="contains">\CurrentVersion\RunOnce</TargetObject>
      <TargetObject condition="contains">\CurrentVersion\Explorer\User Shell Folders</TargetObject>
      <TargetObject condition="contains">\Winlogon\</TargetObject>
      <TargetObject condition="contains">\Image File Execution Options\</TargetObject>
      <TargetObject condition="contains">\Policies\Microsoft\Windows Defender\</TargetObject>
      <TargetObject condition="contains">\Windows Defender\</TargetObject>
      <TargetObject condition="contains">\Sysmon\</TargetObject>
      <TargetObject condition="contains">\CurrentVersion\Internet Settings\</TargetObject>
      <TargetObject condition="contains">\Active Setup\</TargetObject>
      <TargetObject condition="contains">\AppInit_DLLs</TargetObject>
    </RegistryEvent>

    <!-- ===================================================================
         Event 10 - Process access
         Injection and hollowing detection. Exclude-based so every access is
         seen; the excluded GrantedAccess values are the benign
         query/read accesses that would otherwise dominate the log.
         =================================================================== -->
    <ProcessAccess onmatch="exclude">
      <GrantedAccess condition="is">0x1000</GrantedAccess>
      <GrantedAccess condition="is">0x400</GrantedAccess>
      <GrantedAccess condition="is">0x1400</GrantedAccess>
      <GrantedAccess condition="is">0x800</GrantedAccess>
      <GrantedAccess condition="is">0x2000</GrantedAccess>
      <GrantedAccess condition="is">0x8</GrantedAccess>
      <!-- Defender opens many processes; that traffic is noise here. -->
      <TargetImage condition="end with">\MsMpEng.exe</TargetImage>
    </ProcessAccess>

    <!-- ===================================================================
         Event 8 - Create remote thread
         Classic injection primitive.
         =================================================================== -->
    <CreateRemoteThread onmatch="include">
      <TargetImage condition="end with">\explorer.exe</TargetImage>
      <TargetImage condition="end with">\lsass.exe</TargetImage>
      <TargetImage condition="end with">\svchost.exe</TargetImage>
      <TargetImage condition="end with">\winlogon.exe</TargetImage>
      <TargetImage condition="end with">\RuntimeBroker.exe</TargetImage>
      <TargetImage condition="end with">\AcroRd32.exe</TargetImage>
      <TargetImage condition="end with">\AcroEdge.exe</TargetImage>
      <TargetImage condition="end with">\msedge.exe</TargetImage>
      <TargetImage condition="end with">\chrome.exe</TargetImage>
      <TargetImage condition="end with">\powershell.exe</TargetImage>
    </CreateRemoteThread>

    <!-- ===================================================================
         Event 15 - FileCreateStreamHash
         Executable content written without a normal file path, and
         content hashing. One of the highest-value signals for reflective
         loading and in-memory staging.
         =================================================================== -->
    <FileCreateStreamHash onmatch="include">
      <TargetFilename condition="end with">.exe</TargetFilename>
      <TargetFilename condition="end with">.dll</TargetFilename>
      <TargetFilename condition="end with">.bin</TargetFilename>
      <TargetFilename condition="end with">.dat</TargetFilename>
      <TargetFilename condition="end with">.tmp</TargetFilename>
    </FileCreateStreamHash>

    <!-- ===================================================================
         Event 25 - Process tampering
         Process image replacement and unlinking: the direct observable of
         process hollowing. Rare enough to capture unconditionally.
         =================================================================== -->
    <ProcessTampering onmatch="exclude" />

    <!-- ===================================================================
         Event 5 - Process terminate
         Records the death of the processes that did the work.
         =================================================================== -->
    <ProcessTerminate onmatch="include">
      <Image condition="end with">\AcroRd32.exe</Image>
      <Image condition="end with">\AcroEdge.exe</Image>
      <Image condition="end with">\Acrobat.exe</Image>
      <Image condition="end with">\FoxitReader.exe</Image>
      <Image condition="end with">\SumatraPDF.exe</Image>
      <Image condition="end with">\msedge.exe</Image>
      <Image condition="end with">\chrome.exe</Image>
      <Image condition="end with">\powershell.exe</Image>
      <Image condition="end with">\pwsh.exe</Image>
    </ProcessTerminate>

  </EventFiltering>
</Sysmon>
